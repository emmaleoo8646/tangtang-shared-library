generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AgeBand {
  AGE_0_3
  AGE_4_6
  AGE_7_9
  AGE_10_12
  AGE_13_PLUS
}

enum OptionKind {
  CATEGORY
  AGE
  CONDITION
}

enum BookCondition {
  LIKE_NEW
  GOOD
  FAIR
  WELL_LOVED
}

enum BookStatus {
  DRAFT
  AVAILABLE
  RESERVED
  ON_LOAN
  OFF_SHELF
}

enum AiReviewStatus {
  NOT_REQUESTED
  NEEDS_CONFIRMATION
  CONFIRMED
  FAILED
}

enum LoanStatus {
  REQUESTED
  APPROVED
  HANDOFF_AGREED
  LENT
  RETURN_REQUESTED
  RETURNED
  CANCELLED
  REJECTED
  EXPIRED
}

model Family {
  id              String         @id @default(cuid())
  phoneLookupHash String?        @unique
  phoneCiphertext String?
  username        String?        @unique
  emailLookupHash String?        @unique
  emailCiphertext String?
  emailVerifiedAt DateTime?
  passwordHash    String?
  displayName     String
  status          FamilyStatus   @default(ACTIVE)
  children        ChildProfile[]
  books           Book[]
  borrowedLoans   Loan[]         @relation("BorrowerFamily")
  ownedLoans      Loan[]         @relation("OwnerFamily")
  sessions        Session[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ChildProfile {
  id                 String   @id @default(cuid())
  familyId           String
  family             Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nickname           String
  ageOptionId        String
  ageOption          CatalogOption @relation("ChildAge", fields: [ageOptionId], references: [id])
  readingPreferences String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([familyId])
}

model Book {
  id               String         @id @default(cuid())
  ownerFamilyId    String
  ownerFamily      Family         @relation(fields: [ownerFamilyId], references: [id], onDelete: Restrict)
  title            String
  author           String?
  summary          String?
  nonChildren      Boolean        @default(false)
  categoryOptionId String?
  categoryOption   CatalogOption? @relation("BookCategory", fields: [categoryOptionId], references: [id])
  ageOptionId      String?
  ageOption        CatalogOption? @relation("BookAge", fields: [ageOptionId], references: [id])
  conditionOptionId String
  conditionOption   CatalogOption @relation("BookCondition", fields: [conditionOptionId], references: [id])
  status           BookStatus     @default(DRAFT)
  aiReviewStatus   AiReviewStatus @default(NOT_REQUESTED)
  coverObjectKey   String?
  coverMimeType    String?
  coverData        Bytes?
  loans            Loan[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerFamilyId, status])
  @@index([title])
  @@index([categoryOptionId, ageOptionId])
}

model CatalogOption {
  id                  String @id @default(cuid())
  kind                OptionKind
  label               String
  sortOrder           Int @default(0)
  active              Boolean @default(true)
  booksByCategory     Book[] @relation("BookCategory")
  booksByAge          Book[] @relation("BookAge")
  booksByCondition    Book[] @relation("BookCondition")
  childrenByAge       ChildProfile[] @relation("ChildAge")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([kind, label])
  @@index([kind, active, sortOrder])
}

model AdminAccount {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  active       Boolean @default(true)
  sessions     AdminSession[]
  auditEvents  AdminAuditEvent[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminSession {
  id        String @id @default(cuid())
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model AdminAuditEvent {
  id        String @id @default(cuid())
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id])
  action    String
  targetId  String
  createdAt DateTime @default(now())
}

model Loan {
  id                       String     @id @default(cuid())
  bookId                   String
  book                     Book       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  ownerFamilyId            String
  ownerFamily              Family     @relation("OwnerFamily", fields: [ownerFamilyId], references: [id], onDelete: Restrict)
  borrowerFamilyId         String
  borrowerFamily           Family     @relation("BorrowerFamily", fields: [borrowerFamilyId], references: [id], onDelete: Restrict)
  status                   LoanStatus @default(REQUESTED)
  handoffDetailsCiphertext String?
  requestedAt              DateTime   @default(now())
  approvedAt               DateTime?
  lentAt                   DateTime?
  dueAt                    DateTime?
  returnedAt               DateTime?
  borrowerLentConfirmedAt  DateTime?
  ownerLentConfirmedAt     DateTime?
  borrowerReturnConfirmedAt DateTime?
  ownerReturnConfirmedAt   DateTime?
  renewalRequestedAt       DateTime?
  renewedAt                DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([bookId, status])
  @@index([ownerFamilyId, status])
  @@index([borrowerFamilyId, status])
}

model Session {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([familyId])
}

model LoginCode {
  phoneHash String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  sendCount Int      @default(1)
  windowStart DateTime @default(now())
}

enum EmailCodePurpose {
  REGISTER
  RESET
}

model EmailCode {
  emailHash   String
  purpose     EmailCodePurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int              @default(0)
  sentAt      DateTime         @default(now())
  sendCount   Int              @default(1)
  windowStart DateTime         @default(now())

  @@id([emailHash, purpose])
  @@index([sentAt])
}

model AuthThrottle {
  identifierHash String   @id
  attempts       Int      @default(0)
  windowStart    DateTime @default(now())
  blockedUntil   DateTime?
}
