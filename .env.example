# Copy this file to .env for local development. Never commit real secrets.
PORT=3000
DATABASE_URL=postgresql://tangtang:tangtang_local_only@localhost:5432/tangtang_library?schema=public
ADMIN_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required in production; generate a random value of at least 32 characters.
AUTH_SECRET=
# Production email verification and password recovery (SMTP over TLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_EMAIL_ALLOWLIST=

# AI is called only by the API. Leave empty until the intelligent publishing stage.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Production uses Aliyun OSS. Local development stores files under .local-data/.
STORAGE_DRIVER=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
