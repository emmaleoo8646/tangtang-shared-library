# Copy this file to .env for local development. Never commit real secrets.
PORT=3000
DATABASE_URL=postgresql://tangtang:tangtang_local_only@localhost:5432/tangtang_library?schema=public
ADMIN_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required in production; generate a random value of at least 32 characters.
AUTH_SECRET=
# Production email verification and password recovery (SMTP over TLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_EMAIL_ALLOWLIST=

# MiniMax book recognition and web search run only in the API. Keep the key server-side.
AI_PROVIDER=minimax
AI_API_KEY=
AI_MODEL=MiniMax-M3
# 中国站密钥默认使用 https://api.minimaxi.com/v1；国际站密钥可改为 https://api.minimax.io/v1。
AI_BASE_URL=https://api.minimaxi.com/v1

# Book cover photos are stored in PostgreSQL only after browser cropping and compression (up to 600 KB each).
STORAGE_DRIVER=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
