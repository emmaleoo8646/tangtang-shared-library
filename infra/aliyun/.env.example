SITE_DOMAIN=library.douwuyou.cn
POSTGRES_PASSWORD=replace-with-long-random-password
# URL-encode special characters in POSTGRES_PASSWORD when constructing DATABASE_URL.
DATABASE_URL=postgresql://tangtang:replace-with-long-random-password@db:5432/tangtang_library?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
# Keep SMS fields empty until the service, sign and template are approved.
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Required before inviting testers: comma-separated approved phone numbers.
TEST_PHONE_ALLOWLIST=00000000000
