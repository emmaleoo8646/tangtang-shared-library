SITE_DOMAIN=books.example.com
POSTGRES_PASSWORD=replace-with-long-random-password
# URL-encode special characters in POSTGRES_PASSWORD when constructing DATABASE_URL.
DATABASE_URL=postgresql://tangtang:replace-with-long-random-password@db:5432/tangtang_library?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
ALIYUN_SMS_SIGN_NAME=approved-sign-name
ALIYUN_SMS_TEMPLATE_CODE=SMS_approved_template_code
ALIBABA_CLOUD_ACCESS_KEY_ID=ram-user-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=ram-user-access-key-secret
# Optional for a restricted test site: comma-separated test phone numbers.
TEST_PHONE_ALLOWLIST=
